# LAMMPS Input Script /@rtoto@rkundato

# Basic setup
units metal
atom_style atomic
boundary p p f

# Read data file
read_data impact_Fe-Ti6Al4V_TiB7.59%.data

neighbor 2.5 bin
neigh_modify delay 0 every 1 check yes one 5000 page 100000


# ============================================================
# PAIR STYLE & PAIR COEFF — MORSE POTENTIAL
# Sistem: Ti6Al4V matrix + TiB filler + Fe
# ============================================================
#
# Fungsi Morse:  E(r) = D0 * [1 - exp(-alpha*(r-r0))]^2 - D0
# Parameter     : D0 [eV]  alpha [Å⁻¹]  r0 [Å]  cutoff [Å]
#
# Mixing rule untuk pasangan heteroatomik (Lorentz-Berthelot):
#   D0    = sqrt(D0_i * D0_j)
#   alpha = (alpha_i + alpha_j) / 2
#   r0    = (r0_i   + r0_j)   / 2
#

pair_style morse 8.0

# ──────────────────────────────────────────────────────────────
# HOMOATOMIK  (6 pasangan diagonal)
# ──────────────────────────────────────────────────────────────

# 1-1: Ti-Ti  [Jacobson & Thompson, 2022]
pair_coeff 1 1  0.4769  1.3885  2.9210  8.0

# 2-2: Al-Al  [Girifalco & Weizer, 1959]
pair_coeff 2 2  0.2703  1.1646  3.2530  8.0

# 3-3: V-V    [Jacobson & Thompson, 2022]
pair_coeff 3 3  0.5765  1.4177  2.7260  8.0

# 4-4: Ti-Ti  [identik Ti — Jacobson & Thompson, 2022]
#      Type 4 adalah atom Ti di dalam partikel TiB.
#      Parameter sama dengan type 1 karena elemen yang sama.
pair_coeff 4 4  0.4769  1.3885  2.9210  8.0

# 5-5: B-B    [Liang 2008; Panda & Chandran 2006]
pair_coeff 5 5  0.3500  1.7200  1.8500  8.0

# 6-6: Fe-Fe  
pair_coeff 6 6  0.4250  1.9690  2.8220  8.0

# ──────────────────────────────────────────────────────────────
# HETEROATOMIK: pasangan yang melibatkan Ti (type 1)
# ──────────────────────────────────────────────────────────────

# 1-2: Ti-Al  [mixing rule]
#      D0    = sqrt(0.4769 * 0.2703) = 0.3590 eV
#      alpha = (1.3885 + 1.1646) / 2 = 1.2766 Å⁻¹
#      r0    = (2.9210 + 3.2530) / 2 = 3.0870 Å
pair_coeff 1 2  0.3590  1.2766  3.0870  8.0

# 1-3: Ti-V   [mixing rule]
#      D0    = sqrt(0.4769 * 0.5765) = 0.5243 eV
#      alpha = (1.3885 + 1.4177) / 2 = 1.4031 Å⁻¹
#      r0    = (2.9210 + 2.7260) / 2 = 2.8235 Å
pair_coeff 1 3  0.5243  1.4031  2.8235  8.0

# 1-4: Ti-Ti  [mixing rule ]
#      D0    = sqrt(0.4769 * 0.4769) = 0.4769 eV
#      alpha = (1.3885 + 1.3885) / 2 = 1.3885 Å⁻¹
#      r0    = (2.9210 + 2.9210) / 2 = 2.9210 Å
pair_coeff 1 4  0.4769  1.3885  2.9210  8.0

# 1-5: Ti-B   [mixing rule]
#      D0    = sqrt(0.4769 * 0.3500) = 0.4086 eV
#      alpha = (1.3885 + 1.7200) / 2 = 1.5543 Å⁻¹
#      r0    = (2.9210 + 1.8500) / 2 = 2.3855 Å
pair_coeff 1 5  0.4086  1.5543  2.3855  8.0

# 1-6: Ti-Fe  [mixing rule]
#      D0    = sqrt(0.4769 * 0.4250) = 0.4502 eV
#      alpha = (1.3885 + 1.9690) / 2 = 1.6787 Å⁻¹
#      r0    = (2.9210 + 2.8220) / 2 = 2.8715 Å
pair_coeff 1 6  0.4502  1.6787  2.8715  8.0

# ──────────────────────────────────────────────────────────────
# HETEROATOMIK: pasangan yang melibatkan Al (type 2)
# ──────────────────────────────────────────────────────────────

# 2-3: Al-V   [mixing rule]
#      D0    = sqrt(0.2703 * 0.5765) = 0.3948 eV
#      alpha = (1.1646 + 1.4177) / 2 = 1.2912 Å⁻¹
#      r0    = (3.2530 + 2.7260) / 2 = 2.9895 Å
pair_coeff 2 3  0.3948  1.2912  2.9895  8.0

# 2-4: Al-Ti2  [mixing rule → identik Al-Ti]
#      D0    = sqrt(0.2703 * 0.4769) = 0.3590 eV
#      alpha = (1.1646 + 1.3885) / 2 = 1.2766 Å⁻¹
#      r0    = (3.2530 + 2.9210) / 2 = 3.0870 Å
pair_coeff 2 4  0.3590  1.2766  3.0870  8.0

# 2-5: Al-B   [mixing rule]
#      D0    = sqrt(0.2703 * 0.3500) = 0.3076 eV
#      alpha = (1.1646 + 1.7200) / 2 = 1.4423 Å⁻¹
#      r0    = (3.2530 + 1.8500) / 2 = 2.5515 Å
pair_coeff 2 5  0.3076  1.4423  2.5515  8.0

# 2-6: Al-Fe  [mixing rule]
#      D0    = sqrt(0.2703 * 0.4250) = 0.3389 eV
#      alpha = (1.1646 + 1.9690) / 2 = 1.5668 Å⁻¹
#      r0    = (3.2530 + 2.8220) / 2 = 3.0375 Å
pair_coeff 2 6  0.3389  1.5668  3.0375  8.0

# ──────────────────────────────────────────────────────────────
# HETEROATOMIK: pasangan yang melibatkan V (type 3)
# ──────────────────────────────────────────────────────────────

# 3-4: V-Ti  [mixing rule → identik V-Ti]
#      D0    = sqrt(0.5765 * 0.4769) = 0.5243 eV
#      alpha = (1.4177 + 1.3885) / 2 = 1.4031 Å⁻¹
#      r0    = (2.7260 + 2.9210) / 2 = 2.8235 Å
pair_coeff 3 4  0.5243  1.4031  2.8235  8.0

# 3-5: V-B    [mixing rule]
#      D0    = sqrt(0.5765 * 0.3500) = 0.4492 eV
#      alpha = (1.4177 + 1.7200) / 2 = 1.5688 Å⁻¹
#      r0    = (2.7260 + 1.8500) / 2 = 2.2880 Å
pair_coeff 3 5  0.4492  1.5688  2.2880  8.0

# 3-6: V-Fe   [mixing rule]
#      D0    = sqrt(0.5765 * 0.4250) = 0.4950 eV
#      alpha = (1.4177 + 1.9690) / 2 = 1.6934 Å⁻¹
#      r0    = (2.7260 + 2.8220) / 2 = 2.7740 Å
pair_coeff 3 6  0.4950  1.6934  2.7740  8.0

# ──────────────────────────────────────────────────────────────
# HETEROATOMIK: pasangan yang melibatkan Ti (type 4)
# ──────────────────────────────────────────────────────────────

# 4-5: Ti-B  [mixing rule]
#      D0    = sqrt(0.4769 * 0.3500) = 0.4086 eV
#      alpha = (1.3885 + 1.7200) / 2 = 1.5543 Å⁻¹
#      r0    = (2.9210 + 1.8500) / 2 = 2.3855 Å
pair_coeff 4 5  0.4086  1.5543  2.3855  8.0

# 4-6: Ti-Fe  [mixing rule]
#      D0    = sqrt(0.4769 * 0.4250) = 0.4502 eV
#      alpha = (1.3885 + 1.9690) / 2 = 1.6787 Å⁻¹
#      r0    = (2.9210 + 2.8220) / 2 = 2.8715 Å
pair_coeff 4 6  0.4502  1.6787  2.8715  8.0

# ──────────────────────────────────────────────────────────────
# HETEROATOMIK: pasangan yang melibatkan B (type 5)
# ──────────────────────────────────────────────────────────────

# 5-6: B-Fe   [mixing rule]
#      D0    = sqrt(0.3500 * 0.4250) = 0.3857 eV
#      alpha = (1.7200 + 1.9690) / 2 = 1.8445 Å⁻¹
#      r0    = (1.8500 + 2.8220) / 2 = 2.3360 Å
pair_coeff 5 6  0.3857  1.8445  2.3360  8.0

#

# ============================================================
# SIMULASI TUMBUKAN BALISTIK: Peluru vs Ti-6Al-4V / TiB Armor
# ============================================================

#       variable impact_vel_ms equal 900      

# ============================================================
# >>>  PARAMETER YANG BISA DIUBAH  <<<
# ============================================================

# [1] Kecepatan impact dalam satuan m/s (SATU-SATUNYA yang perlu diubah)
variable impact_vel_ms equal 1000

# [2] Temperatur awal armor (Kelvin)
variable temp_init equal 300.0

# [3] Geometri armor (Ångström)
variable armor_bottom    equal 30.0
variable armor_thickness equal 208.5

# [4] Ketebalan lapisan fixed di bawah armor (Å) — boundary condition
variable fixed_layer_thickness equal 5.0

# [5] Durasi simulasi (langkah)
variable run_impact  equal 80000   # langkah fase impact utama
variable run_relax   equal 2500    # langkah relaksasi pasca-impact

# ============================================================
# KONVERSI OTOMATIS: m/s  →  Å/ps
# ============================================================
# 1 m/s = 0.01 Å/ps  →  kalikan dengan 0.01
# Kecepatan peluru ke arah -z (menuju armor dari atas)
variable impact_vel_Aps  equal  ${impact_vel_ms}*0.01
variable impact_vel_z    equal -${impact_vel_Aps}
# Contoh: 800 m/s × 0.01 = 8.0 Å/ps  →  vz = -8.0 Å/ps

# Batas auto-stop: simulasi berhenti jika kecepatan peluru < 1% kecepatan awal
# Ini lebih adaptif daripada nilai tetap 0.08 Å/ps
variable stop_threshold  equal  ${impact_vel_Aps}*0.01

# ============================================================
# NAMA FILE OUTPUT OTOMATIS BERDASARKAN KECEPATAN
# ============================================================
variable vel_tag string ${impact_vel_ms}ms

# ============================================================
# GEOMETRI TURUNAN (otomatis dari variabel di atas)
# ============================================================
variable armor_top          equal ${armor_bottom}+${armor_thickness}
variable fixed_region_top   equal ${armor_bottom}+${fixed_layer_thickness}

# ============================================================
# BAGIAN 1: DEFINISI GRUP
# ============================================================

# Grup material:
# type 1,2,3 = lapisan armor (Ti-6Al-4V, TiB, interface)
# type 4     = atom peluru (projectile)
group projectile type 6
group target     type 1 2 3 4 5

# Lapisan bawah armor yang di-fix sebagai boundary condition
# Mencegah seluruh plat armor terdorong ke bawah saat tumbukan
region fixed_region block INF INF INF INF &
       ${armor_bottom} ${fixed_region_top} units box
group  fixed_bottom region fixed_region

# Atom armor yang bebas bergerak (selain lapisan terkunci)
group free_target subtract target fixed_bottom

# ============================================================
# BAGIAN 2: COMPUTE ANALISIS
# ============================================================

compute proj_com       projectile com
compute target_com     target     com
compute proj_temp      projectile temp
compute target_temp    target     temp
compute proj_z_coords  projectile property/atom z
# Posisi ujung terdepan peluru = nilai z minimum semua atom peluru
compute proj_z_min     projectile reduce min c_proj_z_coords

# Inisialisasi semua compute sebelum digunakan di variabel
run 0

# ============================================================
# BAGIAN 3: VARIABEL ANALISIS
# ============================================================

variable step_out         equal step
variable time_out         equal time
variable proj_z_front     equal c_proj_z_min
variable proj_vz          equal vcm(projectile,z)
variable proj_speed       equal sqrt(vcm(projectile,x)^2+vcm(projectile,y)^2+vcm(projectile,z)^2)
# Penetrasi positif = peluru sudah masuk ke dalam armor
variable penetration_depth equal v_armor_top-v_proj_z_front

# ============================================================
# BAGIAN 4: PRINT PARAMETER SIMULASI
# ============================================================

print '=========================================================='
print '   Ti-6Al-4V / TiB BALLISTIC IMPACT SIMULATION'
print '=========================================================='
print "Impact velocity      : ${impact_vel_ms} m/s"
print "                     = ${impact_vel_Aps} Å/ps"
print "                     = vz ${impact_vel_z} Å/ps"
print "Suhu awal armor      : ${temp_init} K"
print "Armor bottom         : ${armor_bottom} Å"
print "Armor thickness      : ${armor_thickness} Å"
print "Armor top            : ${armor_top} Å"
print "Fixed layer          : ${armor_bottom} – ${fixed_region_top} Å"
print "Auto-stop threshold  : ${stop_threshold} Å/ps"
print "Output tag           : ${vel_tag}"
print '=========================================================='

# ============================================================
# BAGIAN 5: MINIMISASI ENERGI
# ============================================================

print 'Memulai minimisasi energi...'
minimize 1e-6 1e-8 1000 10000
print 'Minimisasi energi selesai'
write_data equilibrated_configuration.data

# ============================================================
# BAGIAN 6: EKUILIBRASI ARMOR PADA SUHU AWAL
# ============================================================

print "Memulai ekuilibrasi target pada ${temp_init} K..."

velocity target create ${temp_init} 12345 dist gaussian
fix nve_eq      target nve
fix langevin_eq target langevin ${temp_init} ${temp_init} 0.1 48279

timestep 0.0001
run 5000

unfix nve_eq
unfix langevin_eq
print 'Ekuilibrasi target selesai'

# ============================================================
# BAGIAN 7: SET KECEPATAN PELURU
# ============================================================

print "Menerapkan kecepatan impact: vz = ${impact_vel_z} Å/ps ..."

# Terapkan kecepatan peluru ke arah -z
# Nilai impact_vel_z sudah negatif (ke arah armor)
velocity projectile set 0.0 0.0 ${impact_vel_z} units box

print "Kecepatan peluru berhasil diterapkan: ${impact_vel_ms} m/s"

# ============================================================
# BAGIAN 8: FIX FASE IMPACT
# ============================================================

# NVE untuk peluru dan armor bebas (tidak ada termostat pada peluru)
fix nve_projectile projectile  nve
fix nve_free       free_target nve

# Langevin hanya pada free_target, damping lembut (1.0 ps)
# agar daerah jauh dari tumbukan tetap termal tanpa mengganggu gelombang kejut
fix langevin_free free_target langevin ${temp_init} ${temp_init} 1.0 99371

# Boundary condition: lapisan bawah armor di-freeze
# Gaya pada fixed_bottom = 0 setiap timestep → tidak bergerak
fix freeze_bottom fixed_bottom setforce 0.0 0.0 0.0
velocity fixed_bottom set 0.0 0.0 0.0


# Pada 800 m/s (8 Å/ps) → max timestep = 0.1/8 = 0.0125 ps → gunakan 0.0002 ps (aman)
timestep 0.0002

# ============================================================
# BAGIAN 9: OUTPUT
# ============================================================

thermo 100
thermo_style custom step time temp pe ke etotal press &
             v_proj_speed v_proj_z_front v_penetration_depth
thermo_modify lost warn flush yes

# Nama file trajektori otomatis mengikuti kecepatan (misal: trajectory_800ms.lammpstrj)
dump traj all custom 500 trajectory_${vel_tag}.lammpstrj id type x y z vx vy vz
dump_modify traj sort id

# File analisis penetrasi dengan nama otomatis (misal: penetration_800ms.txt)
fix analysis_out all print 50 &
    '${step_out} ${time_out} ${proj_z_front} ${proj_vz} ${proj_speed} ${penetration_depth}' &
    file penetration_${vel_tag}.txt screen no &
    title '# step time[ps] z_front[A] vz[A/ps] speed[A/ps] penetration[A]'

# ============================================================
# BAGIAN 10: RUN IMPACT UTAMA
# ============================================================

# Auto-stop jika peluru hampir berhenti (kecepatan < 1% kecepatan awal)
# Threshold otomatis: untuk 800 m/s → stop di < 0.08 Å/ps; untuk 1000 m/s → < 0.10 Å/ps
fix auto_stop all halt 200 v_proj_speed < ${stop_threshold}

print "Memulai simulasi impact: ${impact_vel_ms} m/s selama ${run_impact} langkah..."
run ${run_impact}

# ============================================================
# BAGIAN 11: RELAKSASI PASCA-IMPACT
# ============================================================

print 'Fase impact selesai. Memulai relaksasi pasca-impact...'

unfix auto_stop
unfix langevin_free

timestep 0.002

# Dinginkan sistem kembali ke suhu awal setelah tumbukan
fix langevin_relax free_target langevin ${temp_init} ${temp_init} 0.5 77777

run ${run_relax}

# ============================================================
# BAGIAN 12: OUTPUT AKHIR DAN CLEANUP
# ============================================================

print '=========================================================='
print '   HASIL AKHIR SIMULASI'
print '=========================================================='
print "Kecepatan awal peluru     : ${impact_vel_ms} m/s"
print "Posisi ujung peluru akhir : ${proj_z_front} Å"
print "Kecepatan akhir peluru    : ${proj_speed} Å/ps"
print "Total kedalaman penetrasi : ${penetration_depth} Å"
print '=========================================================='

unfix analysis_out
unfix nve_projectile
unfix nve_free
unfix langevin_relax
unfix freeze_bottom
undump traj

# Nama file data akhir otomatis mengikuti kecepatan (misal: final_config_800ms.data)
write_data final_config_${vel_tag}.data

print 'Simulasi selesai!'









